# Xcode
build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Swift Package Manager
.build/
Packages/

# Rust / Cargo
tools/parakeet-cli/target/

# macOS
.DS_Store
*.swp
*~

# App bundles
*.app

# Node / Turborepo
# No trailing slash: worktrees symlink these (a dir-only pattern lets the link be committed).
node_modules
.next/
# Synthetic (ffmpeg-generated) web-editor lab fixtures — never committed.
apps/web/.fixtures
.turbo/
dist/

# Cloudflare Workers
.dev.vars
# Production secrets. `.prod.vars` holds REAL values for `wrangler secret bulk`
# — only the .example template is ever committed.
.prod.vars
.prod.vars.*
!.prod.vars.example
.wrangler/

# Environment files
.env
.env.local
.env.*.local

# Claude Code
.claude/

# Never track local secrets or their backups
.dev.vars*
!.dev.vars.example
*.env
!.env.development
*.bak
*.bak-*
# Every other env file (.env.production, .env.staging, …): only the committed
# development defaults and examples are allowed.
.env.*
!.env.development
!.env.example
!.env.*.example
# Signing material: Apple AuthKey .p8, certificates, provisioning profiles.
*.p8
*.p12
*.pfx
*.pem
*.cer
*.mobileprovision
*.provisionprofile
# Old OpenNext build output (inlines env values; once committed by accident).
.open-next/
