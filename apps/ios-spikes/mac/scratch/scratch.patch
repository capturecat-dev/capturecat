diff -ruN pristine/apps/macos/CaptureCat/Views/Editor/PreviewCompositor/PreviewParityHarness+SpikeD.swift patched/apps/macos/CaptureCat/Views/Editor/PreviewCompositor/PreviewParityHarness+SpikeD.swift
