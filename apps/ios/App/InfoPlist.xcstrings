          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat saves the videos, GIFs and images you export to your photo library."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat saves the videos, GIFs and images you export to your photo library."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat sichert die Videos, GIFs und Bilder, die du exportierst, in deiner Fotomediathek."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat enregistre dans votre photothèque les vidéos, GIF et images que vous exportez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat guarda en tu fototeca los vídeos, GIF e imágenes que exportas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat guarda en tu fototeca los videos, GIF e imágenes que exportas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat salva nella libreria Foto i video, le GIF e le immagini che esporti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CaptureCat salva na sua fototeca os vídeos, GIFs e imagens que você exporta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat bewaart de video’s, GIF’s en afbeeldingen die je exporteert in je fotobibliotheek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCatは、書き出したビデオ、GIF、画像を写真ライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat은 내보낸 비디오, GIF, 이미지를 사진 보관함에 저장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat 会将你导出的视频、GIF 和图片存储到照片图库。"
          }
        }
      }
    }
  },
  "version" : "1.0"
