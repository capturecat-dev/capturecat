diff --git a/apps/ios/App/Fixtures/StoreCreative.swift b/apps/ios/App/Fixtures/StoreCreative.swift
new file mode 100644
index 0000000..01ba106
--- /dev/null
+++ b/apps/ios/App/Fixtures/StoreCreative.swift
@@ -0,0 +1,402 @@
+#if DEBUG
+import AVFoundation
+import UIKit
+
+/// App Store creative (apps/ios/AppStoreAssets): real editor screens on a
+/// believable synthetic screen recording, plus a timed TOUR for the app
+/// preview video (library → project → editor → zoom → playback → export →
+/// share). Debug fixture runs only:
+///
+///     -uiFixtures -uiFixtureNoInbox -uiStoreEditor zoom|background|captions
+///     -uiFixtures -uiFixtureNoInbox -uiStoreTour
+@available(iOS 26, *)
+@MainActor
+enum StoreCreative {
+    static let size = CGSize(width: 1600, height: 1000)
+    static let duration: TimeInterval = 12
+    static var projectName: String { StoreL10n.t("proj1") }
+
+    // Layout of the recorded app (pixels in the 1600×1000 frame).
+    static let field = CGRect(x: 340, y: 262, width: 640, height: 60)
+    /// Buttons grow with their (localized) label.
+    static let createButton = CGRect(x: 340, y: 356, width: max(280, labelWidth(StoreL10n.t("create")) + 92), height: 60)
+    static let inviteButton = CGRect(x: 340, y: 640, width: max(240, labelWidth(StoreL10n.t("sent")) + 92, labelWidth(StoreL10n.t("send")) + 92), height: 60)
+    static func labelWidth(_ text: String) -> CGFloat {
+        (text as NSString).size(withAttributes: [.font: UIFont.systemFont(ofSize: 22, weight: .semibold)]).width
+    }
+    static let clickCreate: TimeInterval = 4.8
+    static let clickInvite: TimeInterval = 9.2
+
+    // MARK: - Editor
+
+    static func makeEditor(captions: Bool, initialTime: TimeInterval) async -> EditorViewController? {
+        let root = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("StoreCreative", isDirectory: true)
+        let dir = root.appendingPathComponent("project-\(UUID().uuidString.prefix(8))", isDirectory: true)
+        try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let movie = root.appendingPathComponent("screen-v2-\(StoreL10n.language).mov")
+        if !FileManager.default.fileExists(atPath: movie.path) {
+            guard await writeMovie(to: movie) else { return nil }
+        }
+        let local = dir.appendingPathComponent("screen.mov")
+        try? FileManager.default.copyItem(at: movie, to: local)
+        let project = Project(id: UUID(), name: projectName, videoURL: local, cameraVideoURL: nil,
+                              duration: duration, recordingSourceKind: .window)
+        project.zoomRegions = [
+            ZoomRegion(id: UUID(), startTime: 3.6, endTime: 6.4, zoomLevel: 1.6, focalPoint: CGPoint(x: 0.34, y: 0.37)),
+            ZoomRegion(id: UUID(), startTime: 8.2, endTime: 10.8, zoomLevel: 1.5, focalPoint: CGPoint(x: 0.34, y: 0.6)),
+        ]
+        // FOCUS: pixelate the account avatar (top right) for the whole take.
+        project.blurRegions = [
+            BlurRegion(startTime: 0.3, endTime: 11.7, label: "Avatar",
+                       rect: CGRect(x: 0.925, y: 0.012, width: 0.05, height: 0.05), intensity: 0.8, style: .pixelate),
+        ]
+        // ANNOTATE: a label while the field is typed into, an arrow at the toast.
+        var label = Annotation(type: .text, startTime: 0.2, endTime: 1.7)
+        label.text = StoreL10n.t("label2")
+        label.x = 0.62; label.y = 0.30
+        var arrow = Annotation(type: .arrow, startTime: 9.7, endTime: 11.8)
+        arrow.x = 0.62; arrow.y = 0.22; arrow.arrowEndX = 0.74; arrow.arrowEndY = 0.12
+        arrow.color = CodableColor(red: 0.486, green: 0.361, blue: 0.941)
+        project.annotations = [label, arrow]
+        // `-uiStoreAspect 4:3|1:1|…`: the project's canvas aspect (the stage grows with it).
+        if let raw = FixtureWorld.value("-uiStoreAspect"), let aspect = AspectRatio(rawValue: raw) { project.settings.aspectRatio = aspect }
+        project.settings.exportSettings.resolution = .hd720
+        project.settings.exportSettings.fps = 30
+        if captions {
+            project.subtitles = [
+                SubtitleSegment(startTime: 0.4, endTime: 3.4, text: StoreL10n.t("cap1")),
+                SubtitleSegment(startTime: 3.6, endTime: 6.6, text: StoreL10n.t("cap2")),
+                SubtitleSegment(startTime: 7.0, endTime: 10.2, text: StoreL10n.t("cap3")),
+                SubtitleSegment(startTime: 10.4, endTime: 12.0, text: StoreL10n.t("cap4")),
+            ]
+            project.settings.showSubtitles = true
+            project.settings.subtitleCustomX = 0.5
+            project.settings.subtitleCustomY = Double(FixtureWorld.value("-uiStoreCaptionY") ?? "0.62") ?? 0.62
+            project.settings.subtitleStyle = .background
+        }
+        guard let data = try? JSONEncoder().encode(project),
+              (try? data.write(to: dir.appendingPathComponent(StudioProjectFolder.documentName))) != nil,
+              let folder = try? StudioProjectFolder.open(dir) else { return nil }
+        let editor = EditorViewController(folder: folder, initialTime: initialTime)
+        editor.onClose = {}
+        return editor
+    }
+
+    /// `-uiStoreEditor <mode>`: the editor over the library, left up for a screenshot.
+    static func showEditor(mode: String, from presenter: UIViewController) {
+        Task { @MainActor in
+            let time: TimeInterval = FixtureWorld.value("-uiStoreTime").flatMap(Double.init) ?? (mode == "captions" ? 2.2 : (mode == "background" ? 7.2 : 5.9))
+            guard let editor = await makeEditor(captions: mode == "captions", initialTime: time) else { return }
+            editor.modalPresentationStyle = .fullScreen
+            CCAlert.topmost(from: presenter).present(editor, animated: false)
+            try? await Task.sleep(nanoseconds: 2_000_000_000)
+            // `-uiStoreTimelineZoom n`: n steps of the timeline's own zoom-in key (×1.5 each).
+            for _ in 0..<(Int(FixtureWorld.value("-uiStoreTimelineZoom") ?? "0") ?? 0) { editor.timeline.zoomTimeline(in: true) }
+            let pane = FixtureWorld.has("-uiStorePane")
+            switch mode {
+            case "zoom":
+                editor.timeline.canvas.setOpenLane(.effects, animated: true)
+                editor.selection.selectedZoomID = editor.project.zoomRegions.first?.id
+                if pane { DispatchQueue.main.asyncAfter(deadline: .now() + 0.8) { editor.openPanel(.effects) } }
+                // `-uiStorePanelOption <title>`: one Effects option's short panel (e.g. the zoom's own rows).
+                if let want = FixtureWorld.value("-uiStorePanelOption") {
+                    DispatchQueue.main.asyncAfter(deadline: .now() + 0.8) {
+                        editor.selection.inspectorTab = .effects
+                        let options = editor.inspector.panelOptions(for: .effects)
+                        print("STORE options: \(options.map { "\($0.id)=\($0.title)" })")
+                        // By id (language-independent) or by its English title.
+                        if let option = options.first(where: { $0.id == want || $0.title == want }) { editor.openPanel(option: option) }
+                    }
+                }
+                if let option = FixtureWorld.value("-uiStoreOption") {
+                    DispatchQueue.main.asyncAfter(deadline: .now() + 1.0) {
+                        editor.toolBar.probeKey(option)?.sendActions(for: .touchUpInside)
+                    }
+                }
+            case "background":
+                if pane { editor.openPanel(.background) } else { openPane(.background, option: FixtureWorld.value("-uiStoreOption") ?? "Gradient", in: editor) }
+            case "captions":
+                if pane { editor.openPanel(.subtitles) } else { openPane(.subtitles, option: FixtureWorld.value("-uiStoreOption"), in: editor) }
+            default:
+                break
+            }
+        }
+    }
+
+    private static func openPane(_ tab: InspectorTab, option: String?, in editor: EditorViewController) {
+        if let key = editor.toolBar.key(for: .pane(tab)) { key.sendActions(for: .touchUpInside) } else { editor.openPanel(tab) }
+        guard let option else { return }
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1.0) {
+            editor.toolBar.probeKey(option)?.sendActions(for: .touchUpInside)
+        }
+    }
+
+    // MARK: - Tour (app preview)
+
+    /// The app-preview take: one continuous run through the app, one idea per
+    /// stretch, with a STORETOUR line per step (record-tour.sh timestamps them;
+    /// render.mjs cuts on them). Each step holds still long enough for the
+    /// preview's camera to move over it.
+    static func runTour(shell: ShellViewController) {
+        Task { @MainActor in
+            func wait(_ s: Double) async { try? await Task.sleep(nanoseconds: UInt64(s * 1_000_000_000)) }
+            func mark(_ step: String) { print("STORETOUR \(step)") }
+            let editorTask = Task { await makeEditor(captions: true, initialTime: 2.8) }
+            mark("library")
+            await wait(2.2)
+            mark("project")
+            shell.library.showProject(FixtureDirector.projectID(1))
+            await wait(2.4)
+            guard let editor = await editorTask.value else { mark("FAIL editor"); return }
+            editor.modalPresentationStyle = .fullScreen
+            mark("editor")
+            CCAlert.topmost(from: shell).present(editor, animated: true)
+            await wait(1.6)
+            // Idea: the zoom block. The timeline zooms in, the lane opens, the block is selected.
+            mark("timeline-zoom")
+            editor.timeline.zoomTimeline(in: true)
+            await wait(0.5)
+            editor.timeline.zoomTimeline(in: true)
+            await wait(0.6)
+            mark("select-zoom")
+            editor.timeline.canvas.setOpenLane(.effects, animated: true)
+            editor.selection.selectedZoomID = editor.project.zoomRegions.first?.id
+            await wait(2.2)
+            editor.selection.selectedZoomID = nil
+            // Idea: the stage zooming in, with captions, as it plays.
+            mark("play")
+            editor.playback.setPlaying(true, for: editor.project)
+            await wait(4.4)
+            mark("pause")
+            editor.playback.setPlaying(false, for: editor.project)
+            await wait(0.6)
+            // Idea: the background, changed in one tap.
+            mark("background")
+            editor.openPanel(.background)
+            await wait(1.6)
+            mark("mesh")
+            // A warmer gradient: the Start / End colour wells, as a person would pick them.
+            editor.project.settings.gradientStartColor = CodableColor(red: 1.0, green: 0.58, blue: 0.34)
+            editor.project.settings.gradientEndColor = CodableColor(red: 0.42, green: 0.33, blue: 0.96)
+            await wait(2.4)
+            // Idea: captions made on the device.
+            mark("subtitles")
+            editor.closePanel(animated: true)
+            await wait(0.4)
+            editor.openPanel(.subtitles)
+            await wait(2.6)
+            editor.closePanel(animated: true)
+            await wait(0.5)
+            // Idea: export and share.
+            mark("export")
+            guard let sheet = editor.presentExport() else { mark("FAIL sheet"); return }
+            await wait(1.4)
+            sheet.exportButton.sendActions(for: .touchUpInside)
+            mark("exporting")
+            for _ in 0..<2400 {
+                await wait(0.1)
+                if sheet.shareButton.window != nil, !sheet.shareButton.isHidden, sheet.shareButton.alpha > 0.9 { break }
+            }
+            mark("exported")
+            await wait(1.6)
+            mark("share")
+            sheet.shareButton.onTap?()
+            await wait(2.5)
+            if sheet.presentedViewController != nil {
+                mark("share-sheet visible")
+                await wait(3.0)
+                sheet.presentedViewController?.dismiss(animated: true)
+                await wait(0.8)
+            } else {
+                mark("share-sheet missing")
+            }
+            mark("share-detail")
+            editor.presentingViewController?.dismiss(animated: true)
+            await wait(0.7)
+            shell.library.showShare("fxShareOnboard")
+            await wait(5.0)
+            mark("end")
+        }
+    }
+
+    // MARK: - The recorded app (synthetic, believable)
+
+    static func writeMovie(to url: URL, fps: Int32 = 30) async -> Bool {
+        try? FileManager.default.removeItem(at: url)
+        guard let writer = try? AVAssetWriter(outputURL: url, fileType: .mov) else { return false }
+        let w = Int(size.width), h = Int(size.height)
+        let input = AVAssetWriterInput(mediaType: .video, outputSettings: [
+            AVVideoCodecKey: AVVideoCodecType.h264, AVVideoWidthKey: w, AVVideoHeightKey: h,
+            AVVideoCompressionPropertiesKey: [AVVideoAverageBitRateKey: 12_000_000],
+        ])
+        input.expectsMediaDataInRealTime = false
+        let adaptor = AVAssetWriterInputPixelBufferAdaptor(assetWriterInput: input, sourcePixelBufferAttributes: [
+            kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA,
+            kCVPixelBufferWidthKey as String: w, kCVPixelBufferHeightKey as String: h,
+        ])
+        guard writer.canAdd(input) else { return false }
+        writer.add(input)
+        writer.startWriting()
+        writer.startSession(atSourceTime: .zero)
+        let frames = Int(duration * Double(fps))
+        for i in 0...frames {
+            let t = min(Double(i) / Double(fps), duration - 0.001)
+            guard let image = frame(at: t), let pool = adaptor.pixelBufferPool else { return false }
