     }
 
+    /// Store art: the same hiking app the demo project records, on a vivid
+    /// backdrop for framed (landscape) takes.
+    @available(iOS 26, *)
+    private static func storeFrame(device: Bool, still: Bool, hue: CGFloat, t: Double, duration: Double) -> CGImage? {
+        let moments: [Double] = [6.9, 1.0, 9.4, 7.4, 4.6, 1.4, 8.0, 10.6]
+        let index = Int(hue * 100) % moments.count
+        let at = still ? moments[index] : (moments[index] + t * 0.15).truncatingRemainder(dividingBy: 11.5)
+        guard let screen = StoreCreative.frame(at: max(0.2, at)) else { return nil }
+        let format = UIGraphicsImageRendererFormat(); format.scale = 1; format.opaque = true
+        let size = device ? CGSize(width: 444, height: 960) : CGSize(width: 960, height: 600)
+        return UIGraphicsImageRenderer(size: size, format: format).image { context in
+            let ctx = context.cgContext
+            if device { UIImage(cgImage: screen).draw(in: CGRect(x: 0, y: 0, width: 444, height: 966)); return }
+            let colors = [color(hue, 0.78, 1).cgColor, color(hue + 0.17, 0.85, 0.82).cgColor] as CFArray
+            ctx.drawLinearGradient(CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0, 1])!,
+                                   start: .zero, end: CGPoint(x: size.width, y: size.height), options: [])
+            let h: CGFloat = 900, w = h * 402 / 874
+            let frame = CGRect(x: size.width / 2 - w / 2, y: 70, width: w, height: h)
+            ctx.saveGState()
+            ctx.setShadow(offset: CGSize(width: 0, height: 20), blur: 50, color: UIColor.black.withAlphaComponent(0.5).cgColor)
+            rounded(ctx, frame.insetBy(dx: -12, dy: -12), 66, UIColor(white: 0.06, alpha: 1))
+            ctx.restoreGState()
+            ctx.saveGState()
+            UIBezierPath(roundedRect: frame, cornerRadius: 54).addClip()
+            UIImage(cgImage: screen).draw(in: frame)
+            ctx.restoreGState()
+            rounded(ctx, CGRect(x: frame.midX - 60, y: frame.minY + 14, width: 120, height: 34), 17, .black)
+        }.cgImage
+    }
+
     private static func color(_ hue: CGFloat, _ s: CGFloat, _ b: CGFloat, _ a: CGFloat = 1) -> UIColor {
         UIColor(hue: hue.truncatingRemainder(dividingBy: 1), saturation: s, brightness: b, alpha: a)
     }
