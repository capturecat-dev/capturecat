<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>so.capturecat.ios.studiolab.export.*</string>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>CaptureCat saves the videos, GIFs and images you export to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>StudioLab reads back the exports it saves to Photos to verify them.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
