    "Heavier keeps momentum — more overshoot and wiggle. Clicks always stay exactly where you clicked." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più pesante mantiene lo slancio: più oscillazione e rimbalzo. I clic restano sempre esattamente dove hai cliccato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越重惯性越大——过冲和晃动更多。点击始终精确停在你点击的位置。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重くすると勢いが残り、行き過ぎや揺れが大きくなります。クリック位置は常に正確に保たれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais peso mantém o impulso — mais ultrapassagem e oscilação. Os cliques sempre ficam exatamente onde você clicou."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무거울수록 관성이 유지되어 더 많이 넘어가고 흔들립니다. 클릭은 항상 클릭한 위치에 정확히 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwaarder houdt meer vaart — meer doorschieten en wiebelen. Klikken blijven altijd precies waar je klikte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus lourd conserve l’élan — plus de dépassement et d’oscillation. Les clics restent toujours exactement là où vous avez cliqué."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwerer behält den Schwung – mehr Überschwingen und Wackeln. Klicks bleiben immer genau dort, wo du geklickt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más peso conserva la inercia: más rebote y oscilación. Los clics siempre quedan exactamente donde hiciste clic."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más peso conserva la inercia: más rebote y oscilación. Los clics siempre quedan exactamente donde hiciste clic."
          }
        }
      }
    },
