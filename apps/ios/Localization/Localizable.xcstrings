    "“%@” hasn't uploaded yet. Discarding deletes it from this %@." : {
      "comment" : "First argument is the recording name, second is iPhone or iPad",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è ancora stato caricato. Scartandolo lo elimini da questo %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”尚未上传。丢弃会将其从这台 %@ 上删除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”はまだアップロードされていません。破棄すると、この%2$@から削除されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ainda não foi enviado. Descartar apaga a gravação deste %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’이(가) 아직 업로드되지 않았습니다. 폐기하면 이 %2$@에서 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is nog niet geüpload. Als je het verwijdert, wordt het van deze %@ verwijderd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas encore été téléversé. Le supprimer l’efface de cet %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wurde noch nicht hochgeladen. Durch das Verwerfen wird es von diesem %2$@ gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” aún no se ha subido. Si lo descartas, se eliminará de este %@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” aún no se sube. Si lo descartas, se eliminará de este %@."
          }
        }
      }
    },
    "“%@” is nearby but signed in to a different account. Use the same account on both." : {
