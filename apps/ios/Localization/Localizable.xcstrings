        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat을 떠나도 됩니다. 내보내기는 계속 진행되며 진행률이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
