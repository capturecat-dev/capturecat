    "Permanently delete your CaptureCat account, your shared videos and cloud projects. An active subscription is cancelled immediately." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente il tuo account CaptureCat, i video condivisi e i progetti nel cloud. Un abbonamento attivo viene annullato immediatamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除你的 CaptureCat 账户、共享视频和云端项目。有效的订阅会被立即取消。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCatアカウント、共有ビデオ、クラウドプロジェクトを完全に削除します。有効なサブスクリプションはただちに解約されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apague permanentemente sua conta do CaptureCat, seus vídeos compartilhados e projetos na nuvem. Uma assinatura ativa é cancelada imediatamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat 계정, 공유된 비디오 및 클라우드 프로젝트를 영구적으로 삭제합니다. 활성 구독은 즉시 취소됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder je CaptureCat-account, je gedeelde video's en cloudprojecten definitief. Een actief abonnement wordt direct opgezegd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer définitivement votre compte CaptureCat, vos vidéos partagées et vos projets cloud. Un abonnement actif est résilié immédiatement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche deinen CaptureCat-Account, deine geteilten Videos und Cloud-Projekte dauerhaft. Ein aktives Abo wird sofort gekündigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de forma permanente tu cuenta de CaptureCat, tus vídeos compartidos y tus proyectos en la nube. Las suscripciones activas se cancelan de inmediato."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de forma permanente tu cuenta de CaptureCat, tus videos compartidos y tus proyectos en la nube. Las suscripciones activas se cancelan de inmediato."
          }
        }
      }
