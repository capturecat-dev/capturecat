    "CaptureCat switches language the next time it opens. Close it from the App Switcher, then open it again." : {
      "comment" : "Language page footnote after a new language was picked",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat cambierà lingua alla prossima apertura. Chiudila dal selettore app, poi riaprila."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat 将在下次打开时切换语言。请从 App 切换器中关闭它，然后重新打开。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語は次回CaptureCatを開いたときに切り替わります。Appスイッチャーで閉じてから、もう一度開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CaptureCat mudará de idioma na próxima vez que for aberto. Feche-o no Seletor de Apps e abra-o novamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat은 다음에 열 때 언어를 변경합니다. 앱 전환기에서 앱을 닫은 다음 다시 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat wisselt van taal wanneer de app de volgende keer wordt geopend. Sluit de app via de appkiezer en open hem opnieuw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat changera de langue à sa prochaine ouverture. Fermez-le depuis le sélecteur d’apps, puis rouvrez-le."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
