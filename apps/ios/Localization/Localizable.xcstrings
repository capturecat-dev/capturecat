    "Drag the ripple on the preview over the tapped spot. It pulses for the block's whole duration." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina l'onda nell'anteprima sul punto toccato. Pulsa per tutta la durata del blocco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将预览上的波纹拖到轻点的位置。它会在块的整个时长内持续脉动。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビュー上の波紋をタップした位置にドラッグします。ブロックの長さの間ずっと脈打ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a onda na pré-visualização até o ponto tocado. Ela pulsa durante toda a duração do bloco."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기의 물결을 탭한 위치로 드래그하세요. 블록이 지속되는 동안 계속 깜박입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep de golf in de voorvertoning naar de plek waar is getikt. Hij pulseert gedurende het hele blok."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l’onde dans l’aperçu sur l’endroit touché. Elle pulse pendant toute la durée du bloc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
