    "You can leave CaptureCat — the export keeps going and shows its progress." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi uscire da CaptureCat: l'esportazione prosegue e ne mostra l'avanzamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以离开 CaptureCat——导出会继续进行并显示进度。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCatを離れても書き出しは続行され、進行状況が表示されます。"
