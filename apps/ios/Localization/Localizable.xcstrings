    "%@ loses access to your CaptureCat account at once. To use it again, connect it again in that app." : {
      "comment" : "Confirm message: revoke an OAuth app",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verliert sofort den Zugriff auf deinen CaptureCat-Account. Um es wieder zu nutzen, verbinde es in der App erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
