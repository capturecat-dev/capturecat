    "The new language appears the next time CaptureCat opens. Close it from the App Switcher, then open it again." : {
      "comment" : "Alert message after changing the app language",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuova lingua apparirà alla prossima apertura di CaptureCat. Chiudila dal selettore app, poi riaprila."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新语言将在下次打开 CaptureCat 时显示。请从 App 切换器中关闭它，然后重新打开。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい言語は次回CaptureCatを開いたときに表示されます。Appスイッチャーで閉じてから、もう一度開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O novo idioma aparecerá na próxima vez que o CaptureCat for aberto. Feche-o no Seletor de Apps e abra-o novamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 언어는 다음에 CaptureCat을 열 때 표시됩니다. 앱 전환기에서 앱을 닫은 다음 다시 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nieuwe taal verschijnt wanneer CaptureCat de volgende keer wordt geopend. Sluit de app via de appkiezer en open hem opnieuw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle langue s’affichera à la prochaine ouverture de CaptureCat. Fermez-le depuis le sélecteur d’apps, puis rouvrez-le."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Sprache erscheint beim nächsten Öffnen von CaptureCat. Schließe die App im App-Umschalter und öffne sie dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo idioma aparecerá la próxima vez que abras CaptureCat. Ciérralo desde el selector de apps y vuelve a abrirlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo idioma aparecerá la próxima vez que abras CaptureCat. Ciérralo desde el selector de apps y vuelve a abrirlo."
          }
        }
      }
    },
