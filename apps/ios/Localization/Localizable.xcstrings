    "ChatGPT adds custom MCP servers on the web only, and editing needs a workspace plan that allows them (Business, Enterprise or Edu)." : {
      "comment" : "Connect AI: ChatGPT caveat",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT fügt eigene MCP-Server nur im Web hinzu, und zum Bearbeiten brauchst du einen Workspace-Tarif, der sie erlaubt (Business, Enterprise oder Edu)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT n’ajoute des serveurs MCP personnalisés que sur le web, et la modification exige un forfait d’espace de travail qui les autorise (Business, Enterprise ou Edu)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT solo añade servidores MCP personalizados en la web, y editar requiere un plan de espacio de trabajo que los permita (Business, Enterprise o Edu)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT solo agrega servidores MCP personalizados en la web, y editar requiere un plan de espacio de trabajo que los permita (Business, Enterprise o Edu)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT aggiunge server MCP personalizzati solo sul web, e per modificare serve un piano workspace che li consenta (Business, Enterprise o Edu)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ChatGPT só adiciona servidores MCP personalizados na web, e editar exige um plano de workspace que os permita (Business, Enterprise ou Edu)."
          }
        },
