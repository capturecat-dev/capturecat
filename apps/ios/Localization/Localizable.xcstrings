          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "효과, 초점 영역, 주석 또는 내레이션을 추가하거나 자르기 도구를 준비합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een effect, focusgebied, aantekening of voice-over toe, of activeert het knipgereedschap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un effet, une zone de mise au point, une annotation ou une voix off, ou active l’outil de découpe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt einen Effekt, einen Fokusbereich, eine Anmerkung oder ein Voice-over hinzu oder aktiviert das Schneidewerkzeug."
