    "This unlinks every Mac, iPhone and iPad on your account from Wi-Fi streaming. Each one reconnects by itself the next time CaptureCat opens on it while signed in." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scollega dallo streaming Wi-Fi tutti i Mac, iPhone e iPad del tuo account. Ognuno si ricollega da solo alla prossima apertura di CaptureCat con l'accesso eseguito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会取消你账户中所有 Mac、iPhone 和 iPad 的 Wi-Fi 传输关联。每台设备下次在登录状态下打开 CaptureCat 时会自动重新连接。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント上のすべてのMac、iPhone、iPadのWi-Fiストリーミングのリンクを解除します。各デバイスは、次回サインインした状態でCaptureCatを開いたときに自動的に再接続されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação desvincula todos os Macs, iPhones e iPads da sua conta da transmissão via Wi-Fi. Cada um se reconecta sozinho na próxima vez que o CaptureCat for aberto nele com a sessão iniciada."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정의 모든 Mac, iPhone 및 iPad의 Wi-Fi 스트리밍 연결이 해제됩니다. 각 기기는 다음에 로그인한 상태로 CaptureCat을 열 때 자동으로 다시 연결됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt elke Mac, iPhone en iPad in je account ontkoppeld van streamen via wifi. Elk apparaat maakt vanzelf opnieuw verbinding zodra CaptureCat er ingelogd wordt geopend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action dissocie chaque Mac, iPhone et iPad de votre compte de la diffusion Wi-Fi. Chacun se reconnecte de lui-même à la prochaine ouverture de CaptureCat, une fois connecté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Macs, iPhones und iPads deines Accounts vom WLAN-Streaming getrennt. Jedes Gerät verbindet sich beim nächsten Öffnen von CaptureCat automatisch wieder, wenn es angemeldet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto desvincula de la transmisión por Wi-Fi todos los Mac, iPhone y iPad de tu cuenta. Cada uno se vuelve a conectar solo la próxima vez que se abra CaptureCat en él con la sesión iniciada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto desvincula de la transmisión por Wi-Fi todos los Mac, iPhone y iPad de tu cuenta. Cada uno se vuelve a conectar solo la próxima vez que se abra CaptureCat en él con la sesión iniciada."
          }
        }
      }
    },
