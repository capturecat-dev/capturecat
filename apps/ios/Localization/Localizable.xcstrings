          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto rapidamente si animano le transizioni di zoom e inclinazione. Più lente sono più cinematografiche."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缩放和倾斜过渡的动画快慢。越慢越有电影感。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ズームと傾きのトランジションのアニメーション速度です。遅いほど映画的な印象になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rapidez com que as transições de zoom e inclinação são animadas. Mais lento parece mais cinematográfico."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확대 및 기울기 전환 애니메이션의 속도입니다. 느릴수록 더 영화처럼 느껴집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe snel zoom- en kantelovergangen animeren. Langzamer voelt filmischer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapidité des transitions de zoom et d’inclinaison. Plus lent fait plus cinéma."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie schnell Zoom- und Neigungsübergänge animiert werden. Langsamer wirkt filmischer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con qué rapidez se animan las transiciones de zoom e inclinación. Más lento resulta más cinematográfico."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con qué rapidez se animan las transiciones de zoom e inclinación. Más lento resulta más cinematográfico."
          }
        }
      }
    },
