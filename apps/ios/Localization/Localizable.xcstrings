    "%@ changed this project while it was also edited on this %@. Choose which side to keep where the two can't be combined — everything else is already merged." : {
      "comment" : "Merge Review intro. First %@ is who else edited, second is the device (Mac, iPad, iPhone).",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha modificato questo progetto mentre veniva modificato anche su questo %2$@. Scegli quale versione mantenere dove le due non si possono combinare: tutto il resto è già unito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 修改了此项目，而它同时也在这台 %@ 上被编辑。请在两边无法合并的地方选择要保留的一方——其他内容都已合并。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトは、この%2$@で編集中に%1$@によっても変更されました。統合できない箇所で、どちらを残すか選択してください。それ以外はすでに統合されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ alterou este projeto enquanto ele também era editado neste %@. Escolha qual lado manter onde os dois não puderem ser combinados — todo o resto já foi mesclado."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 %2$@에서 편집하는 동안 %1$@도 이 프로젝트를 변경했습니다. 두 변경 사항을 합칠 수 없는 부분에서 유지할 쪽을 선택하세요. 나머지는 이미 병합되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft dit project gewijzigd terwijl het ook op deze %@ werd bewerkt. Kies welke kant je wilt behouden waar de twee niet kunnen worden gecombineerd — al het andere is al samengevoegd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a modifié ce projet alors qu’il était aussi modifié sur cet appareil (%@). Choisissez le côté à conserver là où les deux ne peuvent pas être combinés — tout le reste est déjà fusionné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat dieses Projekt geändert, während es auch auf diesem %@ bearbeitet wurde. Wähle, welche Seite du behalten möchtest, wo sich beide nicht kombinieren lassen – alles andere ist bereits zusammengeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha modificado este proyecto mientras también se editaba en este %@. Elige qué versión conservar donde no se puedan combinar; todo lo demás ya está combinado."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ modificó este proyecto mientras también se editaba en este %@. Elige qué versión conservar donde no se puedan combinar; todo lo demás ya está combinado."
          }
        }
      }
    },
