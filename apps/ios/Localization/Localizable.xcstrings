    "A synthesized tick plays at every recorded click — in the preview and in the exported file." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tic sintetizzato suona a ogni clic registrato, nell'anteprima e nel file esportato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次录制的点击都会播放合成的嘀嗒声——预览和导出文件中都有。"
