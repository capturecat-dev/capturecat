    "Deleted by %@ but edited on this %@. Mine keeps the edit; Theirs deletes the annotation." : {
      "comment" : "Merge Review conflict detail. First %@ is who else edited, second is the device (Mac, iPad, iPhone). Mine / Theirs are the segment titles.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminata da %@ ma modificata su questo %@. «Mia» mantiene la modifica; «Loro» elimina l'annotazione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已被 %@ 删除，但在这台 %@ 上被编辑。“我的”保留编辑；“对方的”删除该标注。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が削除しましたが、この%2$@で編集されています。“自分側”では編集を残し、“相手側”では注釈を削除します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagado por %@, mas editado neste %@. “Meu” mantém a edição; “Deles” apaga a anotação."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 삭제했지만 이 %2$@에서 편집했습니다. 내 버전은 편집을 유지하고, 상대 버전은 주석을 삭제합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderd door %@ maar bewerkt op deze %@. ‘Mijn versie’ behoudt de wijziging; ‘Hun versie’ verwijdert de aantekening."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimée par %@ mais modifiée sur cet appareil (%@). « Ma version » conserve la modification ; « Leur version » supprime l’annotation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von %@ gelöscht, aber auf diesem %@ bearbeitet. „Meine“ behält die Änderung, „Andere“ löscht die Anmerkung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo ha eliminado, pero se ha editado en este %@. Mía conserva la edición; Suya elimina la anotación."
          }
        },
        "es-MX" : {
