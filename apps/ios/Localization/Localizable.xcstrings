    },
    "Your %@ plan doesn't include viewer comments. Upgrade at app.capturecat.so/billing to turn them on." : {
      "comment" : "The value is the plan name, e.g. Free",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo piano %@ non include i commenti degli spettatori. Passa a un piano superiore su app.capturecat.so/billing per attivarli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 %@ 方案不包含观看者评论。请前往 app.capturecat.so/billing 升级以开启评论。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@プランには視聴者コメントが含まれていません。有効にするには、app.capturecat.so/billingでアップグレードしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano %@ não inclui comentários de espectadores. Faça upgrade em app.capturecat.so/billing para ativá-los."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 요금제에는 시청자 댓글이 포함되어 있지 않습니다. app.capturecat.so/billing에서 업그레이드하면 켤 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je %@-abonnement omvat geen opmerkingen van kijkers. Upgrade via app.capturecat.so/billing om ze aan te zetten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre forfait %@ n’inclut pas les commentaires des spectateurs. Passez à un forfait supérieur sur app.capturecat.so/billing pour les activer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tarif „%@“ umfasst keine Zuschauerkommentare. Führe unter app.capturecat.so/billing ein Upgrade durch, um sie zu aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan %@ no incluye comentarios de espectadores. Mejora tu plan en app.capturecat.so/billing para activarlos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan %@ no incluye comentarios de espectadores. Mejora tu plan en app.capturecat.so/billing para activarlos."
          }
        }
      }
    },
    "Your %@ plan lets an AI read your projects but not edit them. Editing with AI comes with CaptureCat Pro — upgrade at app.capturecat.so/billing, then come back here." : {
      "comment" : "Connect AI: plan has agent access but not editing; the argument is the plan name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit deinem Tarif „%@“ kann eine KI deine Projekte lesen, aber nicht bearbeiten. Bearbeiten mit KI gehört zu CaptureCat Pro – führe unter app.capturecat.so/billing ein Upgrade durch und komm dann hierher zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre forfait %@ permet à une IA de lire vos projets, mais pas de les modifier. La modification par IA fait partie de CaptureCat Pro : passez à un forfait supérieur sur app.capturecat.so/billing, puis revenez ici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan %@ permite que una IA lea tus proyectos, pero no que los edite. Editar con IA viene con CaptureCat Pro: mejora tu plan en app.capturecat.so/billing y vuelve aquí."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan %@ permite que una IA lea tus proyectos, pero no que los edite. Editar con IA viene con CaptureCat Pro: mejora tu plan en app.capturecat.so/billing y regresa aquí."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo piano %@ consente a un’IA di leggere i progetti ma non di modificarli. La modifica con l’IA è compresa in CaptureCat Pro: passa a un piano superiore su app.capturecat.so/billing, poi torna qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano %@ permite que uma IA leia seus projetos, mas não que os edite. Editar com IA vem com o CaptureCat Pro — faça upgrade em app.capturecat.so/billing e volte aqui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met je %@-abonnement kan een AI je projecten lezen maar niet bewerken. Bewerken met AI hoort bij CaptureCat Pro – upgrade via app.capturecat.so/billing en kom dan hier terug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@プランでは、AIはプロジェクトを読めますが編集はできません。AIによる編集はCaptureCat Proで利用できます。app.capturecat.so/billingでアップグレードしてから、ここに戻ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 요금제에서는 AI가 프로젝트를 읽을 수만 있고 편집할 수는 없습니다. AI 편집은 CaptureCat Pro에서 제공되니 app.capturecat.so/billing에서 업그레이드한 후 여기로 돌아오세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 %@ 方案允许 AI 读取项目，但不能编辑。AI 编辑随 CaptureCat Pro 提供——请前往 app.capturecat.so/billing 升级，然后回到这里。"
          }
        }
      }
    },
    "Your Mac couldn't open it" : {
