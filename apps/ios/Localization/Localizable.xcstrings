    "We couldn't cancel your subscription, so nothing was deleted. Try again in a moment." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile annullare l'abbonamento, quindi non è stato eliminato nulla. Riprova tra poco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们无法取消你的订阅，因此未删除任何内容。请稍后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションを解約できなかったため、何も削除されていません。しばらくしてから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível cancelar sua assinatura, então nada foi apagado. Tente novamente daqui a pouco."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독을 취소할 수 없어 아무것도 삭제되지 않았습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden je abonnement niet opzeggen, dus er is niets verwijderd. Probeer het zo opnieuw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de résilier votre abonnement : rien n’a été supprimé. Réessayez dans un instant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Abo konnte nicht gekündigt werden, daher wurde nichts gelöscht. Versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hemos podido cancelar tu suscripción, así que no se ha eliminado nada. Inténtalo de nuevo en un momento."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos cancelar tu suscripción, así que no se eliminó nada. Inténtalo de nuevo en un momento."
          }
        }
      }
    },
