    "Combining both sides would make two items overlap on this lane. Pick whose timing to keep for both." : {
      "comment" : "Merge Review conflict detail",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinare le due versioni sovrapporrebbe due elementi su questa traccia. Scegli quali tempi mantenere per entrambi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并两边会使此轨道上的两个项目重叠。请选择保留哪一方的时间安排。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方を組み合わせると、このレーンで2つの項目が重なります。どちらのタイミングを両方に使うか選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar os dois lados faria dois itens se sobreporem nesta faixa. Escolha de quem manter o tempo para ambos."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양쪽을 합치면 이 레인에서 두 항목이 겹칩니다. 어느 쪽의 타이밍을 유지할지 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als beide kanten worden gecombineerd, overlappen twee onderdelen op dit spoor. Kies van wie de timing voor beide behouden blijft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combiner les deux côtés ferait se chevaucher deux éléments sur cette piste. Choisissez quel minutage conserver pour les deux."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn beide Seiten kombiniert werden, überlappen sich zwei Objekte auf dieser Spur. Wähle, wessen Timing für beide gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar ambos lados haría que dos elementos se solaparan en esta pista. Elige qué tiempos conservar para ambos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
