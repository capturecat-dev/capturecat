    "Every device signed in to this account is linked automatically. Forgetting them unlinks every Mac, iPhone and iPad until they reconnect." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni dispositivo connesso a questo account viene collegato automaticamente. Dimenticandoli scolleghi tutti i Mac, iPhone e iPad finché non si riconnettono."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有登录此账户的设备都会自动关联。忘记设备会取消关联所有 Mac、iPhone 和 iPad，直到它们重新连接。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントにサインインしているデバイスはすべて自動的にリンクされます。登録を解除すると、再接続するまですべてのMac、iPhone、iPadのリンクが解除されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dispositivos com sessão iniciada nesta conta são vinculados automaticamente. Esquecê-los desvincula todos os Macs, iPhones e iPads até que se conectem novamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정으로 로그인한 모든 기기는 자동으로 연결됩니다. 기기를 지우면 다시 연결할 때까지 모든 Mac, iPhone 및 iPad의 연결이 해제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk apparaat dat met deze account is ingelogd, wordt automatisch gekoppeld. Als je ze vergeet, wordt elke Mac, iPhone en iPad ontkoppeld totdat ze opnieuw verbinding maken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les appareils connectés à ce compte sont liés automatiquement. Les oublier dissocie chaque Mac, iPhone et iPad jusqu’à leur reconnexion."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Gerät, das bei diesem Account angemeldet ist, wird automatisch verknüpft. Wenn du sie vergisst, wird jeder Mac, jedes iPhone und iPad getrennt, bis sie sich wieder verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los dispositivos con sesión iniciada en esta cuenta se vinculan automáticamente. Al olvidarlos, se desvinculan todos los Mac, iPhone y iPad hasta que vuelvan a conectarse."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los dispositivos con sesión iniciada en esta cuenta se vinculan automáticamente. Al olvidarlos, se desvinculan todos los Mac, iPhone y iPad hasta que vuelvan a conectarse."
          }
        }
      }
    },
    "Every save of this project on this %@ is kept here, so you can preview, compare and restore earlier versions." : {
      "comment" : "History panel empty state; the argument is iPhone or iPad",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni salvataggio di questo progetto su questo %@ viene conservato qui, così puoi visualizzare in anteprima, confrontare e ripristinare le versioni precedenti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目在这台 %@ 上的每次存储都会保留在这里，你可以预览、比较和恢复早期版本。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%@でのプロジェクトの保存内容はすべてここに残るため、以前のバージョンをプレビュー、比較、復元できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que este projeto é salvo neste %@, uma cópia fica aqui, para que você possa pré-visualizar, comparar e restaurar versões anteriores."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 %@에서 저장한 이 프로젝트의 모든 버전이 여기에 보관되므로 이전 버전을 미리 보고, 비교하고, 복원할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke keer dat dit project op deze %@ wordt bewaard, wordt de versie hier bewaard, zodat je eerdere versies kunt bekijken, vergelijken en terugzetten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque enregistrement de ce projet sur cet %@ est conservé ici : vous pouvez prévisualiser, comparer et restaurer les versions antérieures."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Sichern dieses Projekts auf diesem %@ wird hier aufbewahrt, sodass du frühere Versionen ansehen, vergleichen und wiederherstellen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que guardas este proyecto en este %@, se conserva aquí para que puedas previsualizar, comparar y restaurar versiones anteriores."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que guardas este proyecto en este %@, se conserva aquí para que puedas previsualizar, comparar y restaurar versiones anteriores."
          }
        }
      }
    },
