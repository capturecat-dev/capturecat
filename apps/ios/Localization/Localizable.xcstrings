    "Captions were regenerated by %@ and edited on the other side. Pick one set of captions." : {
      "comment" : "Merge Review conflict detail; %@ is who else edited",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli sono stati rigenerati da %@ e modificati dall'altra parte. Scegli un set di sottotitoli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕已由 %@ 重新生成，而另一边又编辑了字幕。请选择一组字幕。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕が%@によって再生成され、もう一方で編集されました。どちらの字幕を残すか選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As legendas foram geradas novamente por %@ e editadas do outro lado. Escolha um conjunto de legendas."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 자막을 다시 생성했고 다른 쪽에서 자막을 편집했습니다. 한쪽 자막을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ondertiteling is opnieuw gegenereerd door %@ en aan de andere kant bewerkt. Kies één set ondertitels."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres ont été régénérés par %@ et modifiés de l’autre côté. Choisissez un seul jeu de sous-titres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Untertitel wurden von %@ neu erstellt und auf der anderen Seite bearbeitet. Wähle einen Satz Untertitel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha regenerado los subtítulos y se han editado en el otro lado. Elige un conjunto de subtítulos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ regeneró los subtítulos y se editaron en el otro lado. Elige un conjunto de subtítulos."
          }
        }
      }
    },
