    "Your plan's named-version limit is reached. Unname an older version first." : {
      "comment" : "History error message",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto il limite di versioni con nome del tuo piano. Togli prima il nome a una versione meno recente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到你方案的命名版本上限。请先取消命名一个较早的版本。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランで名前を付けられるバージョンの上限に達しました。先に古いバージョンの名前を外してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite de versões com nome do seu plano foi atingido. Remova o nome de uma versão mais antiga primeiro."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요금제의 이름 지정 버전 한도에 도달했습니다. 먼저 이전 버전의 이름을 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de limiet voor versies met een naam van je abonnement bereikt. Verwijder eerst de naam van een oudere versie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez atteint la limite de versions nommées de votre forfait. Retirez d’abord le nom d’une version plus ancienne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Limit deines Tarifs für benannte Versionen ist erreicht. Entferne zuerst den Namen einer älteren Version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el límite de versiones con nombre de tu plan. Quita primero el nombre a una versión anterior."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcanzaste el límite de versiones con nombre de tu plan. Quita primero el nombre a una versión anterior."
          }
        }
      }
    },
    "Your recordings from your Mac and the web, on your %@ — watch them, share them, and capture new ones that open straight in the editor." : {
      "comment" : "Argument is iPhone or iPad",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registrazioni dal Mac e dal web, sul tuo %@: guardale, condividile e acquisiscine di nuove che si aprono direttamente nell'editor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的 %@ 上查看来自 Mac 和网页的录制内容——观看、共享，还能录制直接在编辑器中打开的新内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacやWebでの録画を%@で。視聴、共有ができ、新しくキャプチャしたものはそのままエディタで開けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas gravações do Mac e da web, no seu %@ — assista, compartilhe e capture novas gravações que abrem direto no editor."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac과 웹에서 만든 녹화를 %@에서 확인하세요. 보고, 공유하고, 새로 캡처하면 바로 편집기에서 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je opnamen van je Mac en het web, op je %@ — bekijk ze, deel ze en maak nieuwe opnamen die direct in de editor openen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos enregistrements depuis votre Mac et le web, sur votre %@ — regardez-les, partagez-les et capturez-en de nouveaux qui s’ouvrent directement dans l’éditeur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahmen von deinem Mac und aus dem Web, auf deinem %@ – ansehen, teilen und neue aufnehmen, die sich direkt im Editor öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grabaciones del Mac y de la web, en tu %@: míralas, compártelas y captura otras nuevas que se abren directamente en el editor."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grabaciones del Mac y de la web, en tu %@: míralas, compártelas y captura otras nuevas que se abren directamente en el editor."
          }
        }
      }
