    "It was edited elsewhere while this %@ had changes that never synced, and the two can't be merged automatically." : {
      "comment" : "Sync conflict alert; the argument is iPhone or iPad",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato modificato altrove mentre questo %@ aveva modifiche mai sincronizzate, e le due versioni non si possono unire automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在别处被编辑过，而这台 %@ 上有从未同步的更改，两者无法自动合并。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%@に同期されていない変更がある間にほかの場所で編集されたため、自動的に統合できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele foi editado em outro lugar enquanto este %@ tinha alterações nunca sincronizadas, e as duas versões não podem ser mescladas automaticamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 %@에 동기화되지 않은 변경 사항이 있는 동안 다른 곳에서 편집되어 두 버전을 자동으로 병합할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is elders bewerkt terwijl deze %@ wijzigingen had die nooit zijn gesynchroniseerd, en de twee kunnen niet automatisch worden samengevoegd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a été modifié ailleurs alors que cet %@ avait des modifications jamais synchronisées, et les deux ne peuvent pas être fusionnées automatiquement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde an anderer Stelle bearbeitet, während dieses %@ nicht synchronisierte Änderungen hatte, und beides lässt sich nicht automatisch zusammenführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha editado en otro lugar mientras este %@ tenía cambios sin sincronizar, y no se pueden combinar automáticamente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se editó en otro lugar mientras este %@ tenía cambios sin sincronizar, y no se pueden combinar automáticamente."
          }
        }
      }
    },
