    "You're offline, so nothing was deleted. Connect to the internet and try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline, quindi non è stato eliminato nulla. Connettiti a Internet e riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你处于离线状态，因此未删除任何内容。请连接互联网后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインのため、何も削除されていません。インターネットに接続して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline, então nada foi apagado. Conecte-se à internet e tente novamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태이므로 아무것도 삭제되지 않았습니다. 인터넷에 연결한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent offline, dus er is niets verwijderd. Maak verbinding met het internet en probeer het opnieuw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne : rien n’a été supprimé. Connectez-vous à Internet et réessayez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline, daher wurde nichts gelöscht. Stelle eine Internetverbindung her und versuch es erneut."
