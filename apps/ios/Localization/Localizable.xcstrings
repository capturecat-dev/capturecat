    "Your Mac records this screen like a plugged-in %@ — with the device frame. No cable." : {
      "comment" : "Argument is iPhone or iPad",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Mac registra questo schermo come un %@ collegato, con la cornice del dispositivo. Senza cavi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 会像录制插线连接的 %@ 一样录制此屏幕——带设备边框。无需连接线。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macはこの画面を、接続された%@のようにデバイスフレーム付きで録画します。ケーブルは不要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Mac grava esta tela como um %@ conectado — com a moldura do dispositivo. Sem cabo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 이 화면을 연결된 %@처럼 기기 프레임과 함께 녹화합니다. 케이블이 필요 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Mac neemt dit scherm op alsof het een aangesloten %@ is — met het apparaatkader. Zonder kabel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac enregistre cet écran comme un %@ branché — avec le cadre de l’appareil. Sans câble."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac nimmt diesen Bildschirm wie ein angeschlossenes %@ auf – mit Geräterahmen. Ohne Kabel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac graba esta pantalla como si fuera un %@ conectado, con el marco del dispositivo. Sin cable."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac graba esta pantalla como si fuera un %@ conectado, con el marco del dispositivo. Sin cable."
          }
        }
      }
    },
