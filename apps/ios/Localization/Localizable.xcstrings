    "Asks you to confirm. Deletes your account and its data, and cancels your subscription." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti chiede conferma. Elimina il tuo account e i relativi dati e annulla l'abbonamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要你确认。将删除你的账户及其数据，并取消你的订阅。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認が求められます。アカウントとそのデータが削除され、サブスクリプションは解約されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede sua confirmação. Apaga sua conta e os dados dela, e cancela sua assinatura."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인을 요청합니다. 계정과 데이터를 삭제하고 구독을 취소합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt om bevestiging. Verwijdert je account en de bijbehorende gegevens, en zegt je abonnement op."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande une confirmation. Supprime votre compte et ses données, et résilie votre abonnement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt zur Bestätigung. Löscht deinen Account und seine Daten und kündigt dein Abo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te pide confirmación. Elimina tu cuenta y sus datos, y cancela tu suscripción."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te pide confirmación. Elimina tu cuenta y sus datos, y cancela tu suscripción."
          }
        }
      }
    },
