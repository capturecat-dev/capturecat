    "Your current version stays in History — restoring adds this one as the newest version." : {
      "comment" : "History restore confirmation message",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione attuale resta nella cronologia: il ripristino aggiunge questa come versione più recente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的当前版本会保留在历史记录中——恢复会将此版本添加为最新版本。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
