<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- REQUIRED for sign-in: the OAuth callback is delivered to a loopback
	     listener this app binds on 127.0.0.1 (RFC 8252). Without this the
	     sandbox blocks the bind and NWListener never reaches .ready, so
	     sign-in hangs with no visible error. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<!-- One-click agent setup: "Connect AI Agents" runs `claude mcp add` /
	     `codex mcp add` in Terminal via Apple Events (the sandbox cannot write
	     other apps' config files directly, and a child process would inherit
	     our sandbox and fail the same way). macOS shows a one-time consent
	     prompt; NSAppleEventsUsageDescription in Info.plist explains it. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
