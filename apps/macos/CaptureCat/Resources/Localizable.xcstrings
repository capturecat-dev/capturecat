      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Web-Editor hat eine neuere Version (Revision %lld), und dieses Projekt hat Änderungen auf diesem Mac, die nie ans Web gesendet wurden. Holen ersetzt sie."
