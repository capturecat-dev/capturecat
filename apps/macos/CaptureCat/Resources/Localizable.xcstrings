    "Anyone with the link can watch, and it's listed on your public profile." : {
      "comment" : "Share visibility description (Public) shown on the AI agent share consent card",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle mit dem Link können zusehen, und es erscheint in deinem öffentlichen Profil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du lien peut regarder, et la vidéo figure sur votre profil public."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera con el enlace puede verlo y aparece en tu perfil público."
