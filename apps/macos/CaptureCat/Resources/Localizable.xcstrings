    "The device can't be captured. Unlock it, keep it connected, and tap “Trust” if asked." : {
      "comment" : "Recording error for a cable-connected iPhone/iPad; Trust is the iOS button name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät kann nicht aufgenommen werden. Entsperre es, lass es verbunden und tippe bei Nachfrage auf „Vertrauen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de capturer l’appareil. Déverrouillez-le, laissez-le connecté et touchez « Se fier » si on vous le demande."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede capturar el dispositivo. Desbloquéalo, mantenlo conectado y toca “Confiar” si se te pide."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede capturar el dispositivo. Desbloquéalo, mantenlo conectado y toca “Confiar” si se te pide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile acquisire il dispositivo. Sbloccalo, tienilo collegato e tocca “Autorizza” se richiesto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível capturar o dispositivo. Desbloqueie-o, mantenha-o conectado e toque em “Confiar” se for solicitado."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat kan niet worden opgenomen. Ontgrendel het, houd het verbonden en tik op ‘Vertrouw’ als daarom wordt gevraagd."
