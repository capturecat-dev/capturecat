        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep opnamen hierheen, of klik met rechts op een opname en kies ‘Voeg toe aan map’."
          }
        },
        "ja" : {
          "stringUnit" : {
