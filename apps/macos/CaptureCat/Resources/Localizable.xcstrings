    "%@ refused the request (HTTP %lld). Sites behind bot protection often block automated browsers." : {
      "comment" : "Web page capture error; first placeholder is the website host, second the HTTP status code",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Anfrage abgelehnt (HTTP %lld). Websites mit Bot-Schutz blockieren oft automatisierte Browser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a refusé la requête (HTTP %lld). Les sites protégés contre les robots bloquent souvent les navigateurs automatisés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha rechazado la solicitud (HTTP %lld). Los sitios con protección contra bots suelen bloquear los navegadores automatizados."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rechazó la solicitud (HTTP %lld). Los sitios con protección contra bots suelen bloquear los navegadores automatizados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha rifiutato la richiesta (HTTP %lld). I siti protetti dai bot spesso bloccano i browser automatizzati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recusou a solicitação (HTTP %lld). Sites com proteção contra bots costumam bloquear navegadores automatizados."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft het verzoek geweigerd (HTTP %lld). Sites met botbeveiliging blokkeren vaak geautomatiseerde browsers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がリクエストを拒否しました（HTTP %lld）。ボット対策のあるサイトは自動ブラウザをブロックすることがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 요청을 거부했습니다(HTTP %lld). 봇 차단 기능이 있는 사이트는 자동화된 브라우저를 차단하는 경우가 많습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了请求（HTTP %lld）。受机器人防护的网站通常会阻止自动化浏览器。"
          }
        }
      }
    },
