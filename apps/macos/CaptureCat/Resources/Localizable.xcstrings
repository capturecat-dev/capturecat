        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina qui le acquisizioni, oppure fai clic destro su una e scegli Aggiungi a cartella."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste capturas para cá ou clique com o botão direito em uma e escolha Adicionar à Pasta."
