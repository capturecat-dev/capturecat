    "Sharp inside the region, graduated blur outside — drag it on the preview." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scharf im Bereich, abgestufte Unschärfe außerhalb – zieh ihn in der Vorschau."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net dans la zone, flou progressif à l’extérieur — faites-la glisser dans l’aperçu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nítido dentro de la región y desenfoque gradual fuera; arrástralo en la vista previa."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nítido dentro de la región y desenfoque gradual fuera; arrástralo en la vista previa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitido dentro l'area, sfocatura graduale all'esterno: trascinala nell'anteprima."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nítido dentro da região, desfoque gradual fora — arraste na pré-visualização."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scherp binnen het gebied, geleidelijke vervaging erbuiten — sleep het in de voorvertoning."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲内はシャープに、範囲外は段階的にぼかします。プレビュー上でドラッグして調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역 안쪽은 선명하고 바깥쪽은 점차 흐려집니다. 미리보기에서 드래그하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区域内清晰，区域外渐进模糊——在预览上拖移它。"
          }
        }
      }
    },
