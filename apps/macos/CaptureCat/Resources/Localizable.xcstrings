          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimé sur cet appareil (%1$@) mais modifié par %2$@. « Ma version » supprime le zoom ; « Leur version » conserve la modification."
          }
        },
        "es" : {
          "stringUnit" : {
