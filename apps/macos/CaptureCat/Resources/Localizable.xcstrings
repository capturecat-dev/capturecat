    "Drag the block's edges on the ANNOTATE lane to retime it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Ränder des Blocks auf der ANMERKUNGEN-Spur, um sein Timing zu ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les bords du bloc sur la piste ANNOTATIONS pour modifier son minutage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los bordes del bloque en la pista ANOTAR para cambiar su duración."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los bordes del bloque en la pista ANOTAR para cambiar su duración."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i bordi del blocco sulla traccia ANNOTA per cambiarne i tempi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste as bordas do bloco na faixa ANOTAR para alterar o tempo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep de randen van het blok op het AANTEKENEN-spoor om de timing aan te passen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
