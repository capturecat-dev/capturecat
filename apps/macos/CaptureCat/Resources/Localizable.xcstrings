    "Blur softens the region; Pixelate covers it with a mosaic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unschärfe zeichnet den Bereich weich; Verpixeln deckt ihn mit einem Mosaik ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flou adoucit la zone ; Pixeliser la recouvre d’une mosaïque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoque suaviza la región; Pixelado la cubre con un mosaico."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoque suaviza la región; Pixelado la cubre con un mosaico."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfocatura ammorbidisce l'area; Pixel la copre con un mosaico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoque suaviza a região; Pixelizar a cobre com um mosaico."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervaging verzacht het gebied; Pixeleren bedekt het met een mozaïek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼかしは範囲をぼかし、モザイクはモザイクで覆います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흐림 효과는 영역을 부드럽게 하고, 모자이크는 영역을 모자이크로 가립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“模糊”会柔化区域；“像素化”会用马赛克遮盖区域。"
          }
        }
      }
    },
    "Blur softens the region; Pixelate covers it with a mosaic. Animated jitters the mosaic grid over time — the classic censor look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unschärfe zeichnet den Bereich weich; Verpixeln deckt ihn mit einem Mosaik ab. Animiert lässt das Mosaikraster über die Zeit flackern – der klassische Zensur-Look."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flou adoucit la zone ; Pixeliser la recouvre d’une mosaïque. Animé fait vibrer la grille de mosaïque au fil du temps — l’effet de censure classique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoque suaviza la región; Pixelado la cubre con un mosaico. Animado hace vibrar la cuadrícula del mosaico con el tiempo: el clásico efecto de censura."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoque suaviza la región; Pixelado la cubre con un mosaico. Animado hace vibrar la cuadrícula del mosaico con el tiempo: el clásico efecto de censura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfocatura ammorbidisce l'area; Pixel la copre con un mosaico. Animato fa tremolare la griglia del mosaico nel tempo: il classico effetto censura."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoque suaviza a região; Pixelizar a cobre com um mosaico. Animado faz a grade do mosaico tremer ao longo do tempo — o visual clássico de censura."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervaging verzacht het gebied; Pixeleren bedekt het met een mozaïek. Geanimeerd laat het mozaïekraster in de loop van de tijd trillen — de klassieke censuurlook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼかしは範囲をぼかし、モザイクはモザイクで覆います。アニメーションをオンにすると、モザイクの格子が時間とともに揺れる定番の検閲表現になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흐림 효과는 영역을 부드럽게 하고, 모자이크는 영역을 모자이크로 가립니다. 애니메이션을 켜면 모자이크 격자가 시간에 따라 흔들려 전형적인 검열 효과를 냅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“模糊”会柔化区域；“像素化”会用马赛克遮盖区域。“动画”会让马赛克网格随时间抖动——经典的打码效果。"
          }
        }
      }
    },
