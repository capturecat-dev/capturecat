    "Current take will be deleted and recording will immediately restart from 0:00." : {
      "comment" : "Alert message for ‘Restart recording from beginning?’",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Aufnahme wird gelöscht und startet sofort neu bei 0:00."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prise actuelle sera supprimée et l’enregistrement reprendra immédiatement à 0:00."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación actual se eliminará y se volverá a grabar de inmediato desde 0:00."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación actual se eliminará y se volverá a grabar de inmediato desde 0:00."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ripresa attuale verrà eliminata e la registrazione ripartirà subito da 0:00."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação atual será apagada e a gravação recomeçará imediatamente do 0:00."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De huidige opname wordt verwijderd en de opname begint meteen opnieuw vanaf 0:00."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のテイクは削除され、録画はすぐに0:00から再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
