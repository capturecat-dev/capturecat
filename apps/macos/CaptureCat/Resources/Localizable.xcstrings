    "Drag captures here, or right-click one and choose Add to Folder." : {
      "comment" : "Capture library empty state subtitle for an empty folder; Add to Folder is the context menu item name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh Aufnahmen hierher oder klicke mit rechts auf eine und wähle „Zu Ordner hinzufügen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser des captures ici, ou faites un clic droit sur l’une d’elles et choisissez Ajouter au dossier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra capturas aquí o haz clic derecho en una y elige Añadir a carpeta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra capturas aquí o haz clic derecho en una y elige Agregar a carpeta."
          }
