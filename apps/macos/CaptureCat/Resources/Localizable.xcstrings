    "How far this block pushes in — the EFFECTS block shows the level." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit dieser Block heranzoomt – der EFFEKTE-Block zeigt die Stufe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensité du zoom de ce bloc — le bloc EFFETS affiche le niveau."
