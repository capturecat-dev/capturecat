    "Highlights softly dim everything outside the selected region so attention stays on the important area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hervorhebungen dunkeln alles außerhalb des gewählten Bereichs sanft ab, damit die Aufmerksamkeit auf dem Wichtigen bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le surlignage assombrit légèrement tout ce qui se trouve hors de la zone sélectionnée pour garder l’attention sur l’essentiel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resaltados atenúan suavemente todo lo que queda fuera de la región seleccionada para centrar la atención en lo importante."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resaltados atenúan suavemente todo lo que queda fuera de la región seleccionada para centrar la atención en lo importante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le evidenziazioni attenuano leggermente tutto ciò che è fuori dall'area selezionata, così l'attenzione resta sulla parte importante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os destaques escurecem suavemente tudo fora da região selecionada para manter a atenção na área importante."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeringen dimmen alles buiten het geselecteerde gebied zacht, zodat de aandacht bij het belangrijke deel blijft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイライトは選択範囲の外側をやわらかく暗くし、重要な部分に注目を集めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강조는 선택한 영역 바깥을 부드럽게 어둡게 하여 중요한 영역에 시선이 머물게 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高亮会柔和地调暗所选区域以外的一切，让注意力集中在重要区域。"
          }
        }
      }
    },
