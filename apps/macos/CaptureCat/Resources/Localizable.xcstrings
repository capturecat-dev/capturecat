    "Crops the menu bar strip off the recording entirely — adjust Height until the bar is exactly gone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneidet den Menüleistenstreifen komplett aus der Aufnahme – passe die Höhe an, bis die Leiste genau verschwunden ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime entièrement la bande de la barre des menus de l’enregistrement — ajustez Hauteur jusqu’à ce que la barre ait exactement disparu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorta por completo la franja de la barra de menús de la grabación; ajusta la altura hasta que la barra desaparezca exactamente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorta por completo la franja de la barra de menús de la grabación; ajusta la altura hasta que la barra desaparezca exactamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritaglia completamente la striscia della barra dei menu dalla registrazione: regola l'altezza finché la barra non scompare del tutto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta totalmente a faixa da barra de menus da gravação — ajuste a Altura até a barra sumir por completo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snijdt de menubalkstrook volledig uit de opname — pas Hoogte aan tot de balk precies weg is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画からメニューバーの帯を完全に切り取ります。バーがちょうど消えるように高さを調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화에서 메뉴 막대 부분을 완전히 잘라냅니다. 막대가 정확히 사라질 때까지 높이를 조정하세요."
          }
        },
        "zh-Hans" : {
