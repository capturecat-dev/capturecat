    "The clips were cut or trimmed on both sides. Mine keeps this %@'s clips; Theirs keeps %@'s." : {
      "comment" : "Merge Review conflict detail. First %@ is the device (Mac, iPad, iPhone), second is who else edited. Mine / Theirs are the segment titles.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Clips wurden auf beiden Seiten geschnitten oder gekürzt. „Meine“ behält die Clips auf diesem %@, „Andere“ die von %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans ont été coupés ou rognés des deux côtés. « Ma version » conserve les plans de cet appareil (%@) ; « Leur version » conserve ceux de %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips se han cortado o recortado en ambos lados. Mía conserva los clips de este %@; Suya conserva los de %@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips se cortaron o recortaron en ambos lados. Mía conserva los clips de este %@; Suya conserva los de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip sono state tagliate o rifilate su entrambi i lati. «Mia» mantiene le clip di questo %@; «Loro» mantiene quelle di %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os clipes foram cortados ou aparados nos dois lados. “Meu” mantém os clipes deste %@; “Deles” mantém os de %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De clips zijn aan beide kanten geknipt of ingekort. ‘Mijn versie’ behoudt de clips van deze %@; ‘Hun versie’ die van %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップが両方でカットまたはトリムされました。“自分側”ではこの%1$@のクリップを、“相手側”では%2$@のクリップを残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양쪽에서 클립을 자르거나 다듬었습니다. 내 버전은 이 %1$@의 클립을, 상대 버전은 %2$@의 클립을 유지합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两边都剪切或修剪了片段。“我的”保留这台 %@ 上的片段；“对方的”保留 %@ 的片段。"
          }
        }
      }
    },
