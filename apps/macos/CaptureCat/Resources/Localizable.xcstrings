          }
        }
      }
    },
    "Drag the pad to skew the screen — left/right tips a side back, up/down tips the top or bottom back. The preview updates live." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh auf dem Feld, um den Bildschirm zu neigen – links/rechts kippt eine Seite nach hinten, oben/unten kippt die Ober- oder Unterkante nach hinten. Die Vorschau aktualisiert sich live."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le pavé pour incliner l’écran — gauche/droite fait basculer un côté vers l’arrière, haut/bas fait basculer le haut ou le bas. L’aperçu se met à jour en direct."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el panel para inclinar la pantalla: izquierda/derecha echa un lado hacia atrás y arriba/abajo inclina la parte superior o inferior. La vista previa se actualiza en directo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el panel para inclinar la pantalla: izquierda/derecha echa un lado hacia atrás y arriba/abajo inclina la parte superior o inferior. La vista previa se actualiza en directo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il pad per inclinare lo schermo: sinistra/destra spinge indietro un lato, su/giù spinge indietro la parte alta o bassa. L'anteprima si aggiorna in tempo reale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o painel para inclinar a tela — esquerda/direita inclina um lado para trás, cima/baixo inclina o topo ou a base para trás. A pré-visualização é atualizada em tempo real."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep over het vlak om het scherm te kantelen — links/rechts kantelt een zijkant naar achteren, omhoog/omlaag de boven- of onderkant. De voorvertoning wordt direct bijgewerkt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッドをドラッグして画面を傾けます。左右で側面を、上下で上端または下端を奥に倒します。プレビューはリアルタイムで更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패드를 드래그하여 화면을 기울이세요. 왼쪽/오른쪽은 한쪽 측면을, 위/아래는 상단이나 하단을 뒤로 기울입니다. 미리보기가 실시간으로 업데이트됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移控制板来倾斜屏幕——左右拖移使一侧向后倾，上下拖移使顶部或底部向后倾。预览会实时更新。"
          }
        }
      }
    },
