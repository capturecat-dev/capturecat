{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deliberately NOT capturecat-web: this deploys alongside the existing
  // OpenNext worker until cutover, at which point the custom domains
  // (capturecat.so, www, app) move over from apps/web/wrangler.jsonc.
  // Deployed Worker name predates the folder rename (web-start → web).
  // Changing it would create a NEW Worker and orphan domains + secrets —
  // leave it unless deliberately migrating the deployment.
  "name": "capturecat-start",
  // Deploying with these attached REASSIGNS the hostnames to this worker —
  // which is how the cutover from the old capturecat-web worker was done
  // (2026-08-24). NOT admin.capturecat.so — that belongs to the admin worker.
  "routes": [
    { "pattern": "capturecat.so", "custom_domain": true },
    { "pattern": "www.capturecat.so", "custom_domain": true },
    { "pattern": "app.capturecat.so", "custom_domain": true }
    // NEVER add a zone-wide `*/*` route here. Every deploy (re)creates the
    // routes listed, and `*/*` → this Worker captures api.capturecat.so and
    // admin.capturecat.so too, taking both down (1019 on 2026-09-30, 421 on
    // 2026-10-01 when a deploy put it back). Custom share domains need a
    // design proven on a non-production zone first — apps/api/README.md.
  ],
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "src/server.ts",
  "vars": {
    "VITE_API_URL": "https://api.capturecat.so",
    "VITE_SITE_URL": "https://capturecat.so"
  },
  "observability": { "enabled": true }
}
