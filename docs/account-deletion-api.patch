+    ins("member", { id: "mem-4", organizationId: "org-alice-team", userId: ALICE, role: "owner", createdAt: now });
+    ins("member", { id: "mem-5", organizationId: "org-alice-team", userId: BOB, role: "member", createdAt: now });
