diff --git a/apps/web/src/server/apple-app-site-association.test.ts b/apps/web/src/server/apple-app-site-association.test.ts
new file mode 100644
index 0000000..2dca875
--- /dev/null
+++ b/apps/web/src/server/apple-app-site-association.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+
+import { AASA_PATH, appleAppSiteAssociation, appleAppSiteAssociationResponse } from "./apple-app-site-association";
+
+interface Component {
+  "/": string;
+  exclude?: boolean;
+}
+
+describe("apple-app-site-association", () => {
+  const parsed = JSON.parse(appleAppSiteAssociation) as {
+    applinks: { details: { appIDs: string[]; components: Component[] }[] };
+  };
+
+  it("names the iOS app (team E52HU87CX9, bundle so.capturecat.ios) and nothing else", () => {
+    expect(parsed.applinks.details).toHaveLength(1);
+    expect(parsed.applinks.details[0].appIDs).toEqual(["E52HU87CX9.so.capturecat.ios"]);
+  });
+
+  it("claims ONLY share pages (the .md twin and deeper paths excluded first)", () => {
+    const components = parsed.applinks.details[0].components;
+    const claimed = components.filter((c) => !c.exclude).map((c) => c["/"]);
+    expect(claimed).toEqual(["/share/*"]);
+    const excludes = components.filter((c) => c.exclude).map((c) => c["/"]);
+    expect(excludes).toEqual(["/share/*.md", "/share/*/*"]);
+    // Excludes must come before the claim: iOS takes the first match.
+    expect(components.findIndex((c) => !c.exclude)).toBe(components.length - 1);
+  });
+
+  it("is served as application/json at the well-known path", async () => {
+    expect(AASA_PATH).toBe("/.well-known/apple-app-site-association");
+    const res = appleAppSiteAssociationResponse(new Request(`https://capturecat.so${AASA_PATH}`));
+    expect(res.status).toBe(200);
+    expect(res.headers.get("Content-Type")).toBe("application/json");
+    expect(JSON.parse(await res.text())).toEqual(parsed);
+  });
+});
diff --git a/apps/web/src/server/apple-app-site-association.ts b/apps/web/src/server/apple-app-site-association.ts
new file mode 100644
index 0000000..f33a5b5
--- /dev/null
+++ b/apps/web/src/server/apple-app-site-association.ts
@@ -0,0 +1,27 @@
+/**
+ * Universal links for the CaptureCat iPhone / iPad app: a share link
+ * (capturecat.so/share/<id>) tapped on a device with the app opens its
+ * in-app share viewer (apps/ios/App/ShareViewer). Every other path stays on
+ * the web — the file claims share pages only.
+ *
+ * The file itself is public/.well-known/apple-app-site-association (static
+ * assets, Content-Type set in public/_headers). This serves the SAME bytes from
+ * the Worker, so the path answers JSON on capturecat.so and www.capturecat.so
+ * even when a request reaches the Worker instead of the asset layer (no
+ * redirect: Apple's CDN does not follow one to the apex).
+ */
+import aasa from "../../public/.well-known/apple-app-site-association?raw";
+
+export const AASA_PATH = "/.well-known/apple-app-site-association";
+
+export const appleAppSiteAssociation = aasa;
+
+export function appleAppSiteAssociationResponse(request: Request): Response {
+  return new Response(request.method === "HEAD" ? null : aasa, {
+    status: 200,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "public, max-age=3600",
+    },
+  });
+}
