{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_NAME",
        "NEXT_PUBLIC_SITE_URL",
        "VITE_API_URL",
        "VITE_SITE_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".open-next/**",
        "build/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "deploy": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
